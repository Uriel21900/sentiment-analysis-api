# Environment Configuration for Sentiment Analysis API
# Copy this file to .env and fill in your values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Database / Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Model Settings
MODEL_TYPE=ensemble
MODEL_PATH=./models/sentiment_model.pkl

# External API Keys (get from https://developer.twitter.com/)
# These are optional - the demo uses sample data
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Logging
LOG_LEVEL=INFO

# Feature Flags
ENABLE_REALTIME_PROCESSING=false
ENABLE_EXTERNAL_API=false
